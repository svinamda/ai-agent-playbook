    {
      "parameters": {
        "functionCode": "\nconst baselineRows = $items(\"Read Baseline Metrics\");\n\nfunction getBaseline(step) {\n  const row = baselineRows.find(r => r.json.checkout_step === step);\n  return row ? Number(row.json.baseline_rate) : 0;\n}\n\nreturn items.map(item => {\n  const { checkout_step, cart_value, device, timestamp } = item.json;\n  const baseline_rate = getBaseline(checkout_step);\n\n  let severity = \"LOW\";\n  let action = \"LOG\";\n  let reason = \"Low impact isolated incident\";\n\n  if (checkout_step === \"Payment\") {\n    severity = \"HIGH\";\n    action = \"ALERT\";\n    reason = \"Payment step failure\";\n  }\n\n  if (Number(cart_value) > 200) {\n    severity = \"HIGH\";\n    action = \"ALERT\";\n    reason = \"High cart value failure\";\n  }\n\n  if (device === \"Mobile\") {\n    severity = \"HIGH\";\n    action = \"ALERT\";\n    reason = \"Mobile checkout failure pattern\";\n  }\n\n  return {\n    json: {\n      command_id: Date.now() + \"-\" + Math.random(),\n      action,\n      severity,\n      reason,\n      checkout_step,\n      cart_value,\n      device,\n      baseline_rate,\n      timestamp\n    }\n  };\n});\n"
      },
